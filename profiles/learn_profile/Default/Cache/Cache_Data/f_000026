&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; \n  &lt;p style=&quot;margin-top:10px; margin-bottom:10px; text-align:justify&quot;&gt;&amp;nbsp;&lt;/p&gt; \n  &lt;p style=&quot;margin-top:10px; margin-bottom:10px; text-align:right&quot;&gt;&lt;span style=&quot;line-height:2;&quot;&gt;&lt;span style=&quot;font-family:黑体;&quot;&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;注册中心&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; \n  &lt;p style=&quot;margin-top:10px; margin-bottom:10px; text-align:right&quot;&gt;&lt;span style=&quot;line-height:2;&quot;&gt;&lt;span style=&quot;font-family:黑体;&quot;&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;信息化技术中心&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; \n  &lt;p style=&quot;margin-top:10px; margin-bottom:10px; text-align:right&quot;&gt;&lt;span style=&quot;line-height:2;&quot;&gt;&lt;span style=&quot;font-family:黑体;&quot;&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;2025年9月17日&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;","sfzc":null,"lb":null,"id":"26ef84e89951be7001995580b49e7bee"},{"ggid":"26ef84e89509b8b3019516663a4a0222","title":"关于教学楼研讨间开放使用的通知","owner":"陈卫","reg_date":1739857020000,"end_date":2213107200000,"msg_type":null,"msg_priority":1,"status":null,"detail":"","browse_times":null,"czr":"陈卫","czsj":"1739857076134","bz":"&lt;p style=&quot;text-indent:21.0000pt; text-align:left&quot;&gt;&lt;span style=&quot;font-size:10.5pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;为更好满足师生开展教学活动，经管新楼（建华楼）和第四教室楼的46间研讨间完成智能化改造，自2025年2月17日起，全新教学楼研讨间管理系统上线，原借用系统停用。&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; \n  &lt;p style=&quot;text-indent:21.0000pt; text-align:left&quot;&gt;&lt;span style=&quot;font-size:10.5pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;教学楼研讨间是教学楼公共教室的一种类型，其管理和使用须遵守公共教室的相关规定。研讨间面向任课教师、在校学生开放使用，预约和签到须按照《教学楼研讨间预约管理规定》的要求执行（详见附件）。&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; \n  &lt;p style=&quot;text-indent:21.0000pt; text-align:left&quot;&gt;&lt;span style=&quot;font-size:10.5pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;预约途径&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; \n  &lt;p style=&quot;text-indent:21.0000pt; text-align:left&quot;&gt;&lt;span style=&quot;font-size:10.5pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;1．&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;网络学堂&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;：网络学堂登录-常用链接-教学楼研讨间预约。&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; \n  &lt;p style=&quot;text-indent:21.0000pt; text-align:left&quot;&gt;&lt;span style=&quot;font-size:10.5pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;2．&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;二维码&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;font-size:10.5000pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;：扫描研讨间门外显示屏上二维码&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; \n  &lt;p style=&quot;text-indent:21.0000pt; text-align:left&quot;&gt;&lt;span style=&quot;font-size:10.5pt&quot;&gt;&lt;span style=&quot;font-family:等线&quot;&gt;